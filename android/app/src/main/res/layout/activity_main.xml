<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.mateo.nova.Cielo
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior: marca, encendido y ajustes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_estrella" />

            <TextView
                android:id="@+id/marca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Nova"
                android:textColor="@color/texto"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/encendido"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pastilla"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/encendidoPunto"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/punto" />

                <TextView
                    android:id="@+id/encendidoTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Apagada"
                    android:textColor="@color/texto"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/botonAjustes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icono_tocable"
                android:contentDescription="Ajustes"
                android:src="@drawable/ic_ajustes" />
        </LinearLayout>

        <TextView
            android:id="@+id/saludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.01"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:text="Buenas tardes, Mateo"
            android:textColor="@color/texto"
            android:textSize="32sp" />

        <!-- La estrella: tocala para hablar -->
        <com.mateo.nova.Estrella
            android:id="@+id/estrella"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/estadoTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="Decí «Nova» o tocá la estrella"
            android:textColor="@color/bruma"
            android:textSize="16sp" />

        <!-- Lo que vas diciendo, en vivo -->
        <TextView
            android:id="@+id/parcial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textColor="@color/texto"
            android:textSize="20sp"
            android:visibility="gone" />

        <!-- Modo charla: conversación continua -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/charlar"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:text="Charlar"
            android:textColor="@color/texto"
            android:textSize="15sp"
            app:cornerRadius="100dp"
            app:icon="@drawable/ic_charla"
            app:iconTint="@color/estrella"
            app:strokeColor="@color/linea" />

        <!-- Aviso de configuración pendiente -->
        <LinearLayout
            android:id="@+id/aviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_aviso"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/avisoTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/estrella"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/avisoTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/bruma"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/avisoBoton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Completar"
                android:textColor="@color/sobre_estrella"
                app:backgroundTint="@color/estrella"
                app:cornerRadius="100dp" />
        </LinearLayout>

        <!-- Conversación -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="28dp"
            android:paddingBottom="8dp"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:id="@+id/chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Ideas para arrancar: se ven solo cuando no hay conversación -->
                <LinearLayout
                    android:id="@+id/sugerencias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="10dp"
                        android:text="Probá con"
                        android:textColor="@color/bruma"
                        android:textSize="14sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="2dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Escribir en vez de hablar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_entrada"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="7dp">

            <EditText
                android:id="@+id/entrada"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Escribile a Nova…"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:textColor="@color/texto"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/enviar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_boton_enviar"
                android:contentDescription="Enviar"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_enviar" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
