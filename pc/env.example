# Copiá este archivo como .env y completá tu clave
# Clave GRATIS de Google: https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=AIza...

# Personalización
NOMBRE=Nova
USUARIO=Mateo
CIUDAD=Buenos Aires
VOZ=es-AR-ElenaNeural
VELOCIDAD_VOZ=+8%

# Límite propio de consultas por hora (cuida la cuota gratis). 0 = sin límite
LIMITE_POR_HORA=60

# Avanzado
MODELO=gemini-3.8-flash
MODELOS_RESPALDO=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
SEGUIR_CHARLANDO=1
