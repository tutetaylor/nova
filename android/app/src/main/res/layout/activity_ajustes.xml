<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.mateo.nova.Cielo
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/atras"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icono_tocable"
                android:contentDescription="Volver"
                android:src="@drawable/ic_atras" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ajustes"
                android:textColor="@color/texto"
                android:textSize="22sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Pasos para que funcione: es una secuencia real, por eso van numerados -->
                <TextView style="@style/Nova.Seccion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Para que funcione" />

                <LinearLayout
                    android:id="@+id/permisos"
                    style="@style/Nova.Grupo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <TextView style="@style/Nova.Seccion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Tu asistente" />

                <LinearLayout style="@style/Nova.Grupo" android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Nombre" />
                    <EditText android:id="@+id/nombre" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Nova" android:importantForAutofill="no"
                        android:inputType="textCapWords" />
                    <TextView style="@style/Nova.Ayuda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Es también la palabra para llamarlo. Usá una palabra común en español." />

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="¿Cómo te llamás?" />
                    <EditText android:id="@+id/usuario" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="textPersonName|textCapWords" />

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="Tu ciudad" />
                    <EditText android:id="@+id/ciudad" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="textCapWords" />
                    <TextView style="@style/Nova.Ayuda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Para el clima cuando no decís dónde." />

                    <LinearLayout
                        android:id="@+id/filaVoz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_campo"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="60dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Voz" android:textColor="@color/bruma" android:textSize="13sp" />
                        <TextView android:id="@+id/filaVozValor" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium" android:textColor="@color/texto" android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/filaPersonalidad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_campo"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="60dp"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Personalidad" android:textColor="@color/bruma" android:textSize="13sp" />
                        <TextView android:id="@+id/filaPersonalidadValor" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium" android:textColor="@color/texto" android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginBottom="0dp"
                                android:text="Pedir permiso antes de actuar" />
                            <TextView android:id="@+id/ayudaConfirmar" style="@style/Nova.Ayuda"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/confirmar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Pedir permiso antes de actuar"
                            app:thumbTint="@color/sobre_estrella"
                            app:trackTint="@color/estrella" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:layout_marginBottom="0dp"
                                android:text="Leerme los mensajes que llegan" />
                            <TextView style="@style/Nova.Ayuda"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="WhatsApp, Instagram, Telegram y SMS. No lee si estás en una llamada o en «No molestar»." />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/leerMensajes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Leerme los mensajes que llegan" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/Nova.Seccion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cerebro gratis" />

                <LinearLayout style="@style/Nova.Grupo" android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Clave de Gemini" />
                    <EditText android:id="@+id/clave" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="AIza…" android:importantForAutofill="no"
                        android:inputType="textPassword" />
                    <TextView android:id="@+id/linkClave" style="@style/Nova.Ayuda" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:background="?attr/selectableItemBackground"
                        android:paddingTop="4dp" android:paddingBottom="4dp"
                        android:text="Conseguila gratis en aistudio.google.com/apikey" android:textColor="@color/nebulosa" />

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="Consultas por hora" />
                    <EditText android:id="@+id/limite" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="number" />
                    <TextView android:id="@+id/uso" style="@style/Nova.Ayuda" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="Modelo" />
                    <EditText android:id="@+id/modelo" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:importantForAutofill="no" android:inputType="text" />
                    <TextView style="@style/Nova.Ayuda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Si se queda sin cuota, Nova prueba solo con otros modelos gratis." />
                </LinearLayout>

                <TextView style="@style/Nova.Seccion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Conexiones" />

                <LinearLayout style="@style/Nova.Grupo" android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Código de la PC" />
                    <EditText android:id="@+id/codigoVinculo" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="Lo ves en Nova para PC › Ajustes"
                        android:importantForAutofill="no" android:inputType="textVisiblePassword" />
                    <TextView style="@style/Nova.Ayuda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Para manejar la PC desde el celular (y buscar el celular desde la PC), desde cualquier lugar. Todo va cifrado." />

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="Repo de GitHub" />
                    <EditText android:id="@+id/repo" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="usuario/nova" android:importantForAutofill="no"
                        android:inputType="textUri" />

                    <TextView style="@style/Nova.Etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="Token de GitHub (solo lectura)" />
                    <EditText android:id="@+id/tokenGithub" style="@style/Nova.Campo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="github_pat_…" android:importantForAutofill="no"
                        android:inputType="textPassword" />
                    <TextView style="@style/Nova.Ayuda" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Para que Nova se actualice sola desde tu repo privado." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buscarActualizacion"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Buscar actualización"
                        android:textColor="@color/estrella"
                        app:cornerRadius="100dp"
                        app:strokeColor="@color/estrella" />
                    <TextView android:id="@+id/versionActual" style="@style/Nova.Ayuda" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/borrarCharla"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:text="Borrar la conversación de la pantalla"
                    android:textColor="@color/bruma" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/guardar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="Guardar cambios"
            android:textColor="@color/sobre_estrella"
            android:textSize="16sp"
            app:backgroundTint="@color/estrella"
            app:cornerRadius="100dp" />
    </LinearLayout>
</FrameLayout>
